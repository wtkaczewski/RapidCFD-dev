.SUFFIXES: .C .cxx .cc .cpp

# -Woverloaded-virtual may produce spurious warnings, disable for now
c++WARN     = \
    -w

c++LESSWARN = \

# Suppress CGAL warnings
c++CGALWARN = -Wno-c++11-extensions -Wno-sometimes-uninitialized -Wno-mismatched-tags

CC          = hipcc -std=c++11 -m64 -fPIC --amdgpu-target=gfx900 
#gfx803  --polaris
#gfx900  --vega10

include $(RULES)/c++$(WM_COMPILE_OPTION)

# --gpu-architecture=sm_62
ptFLAGS     = -DNoRepository  -D__HOST____DEVICE__='__host__ __device__'

c++FLAGS    = $(GFLAGS) $(c++WARN) $(c++LESSWARN) $(c++OPT) $(c++DBUG) $(ptFLAGS)  $(LIB_HEADER_DIRS) 

Ctoo        = $(WM_SCHEDULER) $(CC) $(c++FLAGS)  $ -c $$SOURCE -o $@
cxxtoo      = $(Ctoo)
cctoo       = $(Ctoo)
cpptoo      = $(Ctoo)

LINK_LIBS   = $(c++DBUG)

LINKLIBSO   = $(CC) $(c++FLAGS) -shared 
LINKEXE     = $(CC) $(c++FLAGS) -Xlinker

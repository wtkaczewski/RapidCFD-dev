.SUFFIXES: .c .h

cWARN        = -Wall

cc          = hipcc -m64 --amdgpu-target=$(WM_GPU_ARCH)

include $(RULES)/c$(WM_COMPILE_OPTION)

cFLAGS      = $(GFLAGS) $(cWARN) $(cOPT) $(cDBUG) $(LIB_HEADER_DIRS) -fPIC

ctoo        = $(WM_SCHEDULER) $(cc) $(cFLAGS) -c $$SOURCE -o $@

LINK_LIBS   = $(cDBUG)

LINKLIBSO   = $(cc) -shared --hip-link --allow-shlib-undefined
LINKEXE     = $(cc) -Xlinker  -Xlinker -z -Xlinker nodefs --hip-link --allow-shlib-undefined
